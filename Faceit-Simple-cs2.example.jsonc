// Faceit-Simple-cs2 — разминка как на Faceit.
// Комментарии // и /* */ и запятая после последнего элемента разрешены.
// После правки: css_faceitsimple reload в консоли сервера.
{
  // false — плагин ничего не делает.
  "Enabled": true,

  // Warmup money amount
  // Кол-во денег на разминке
  "StartMoney": 16000,

  // Money apply mode: 0 - after buy, 1 - after spawn
  // Способ выдачи денег: 0 - после покупки, 1 - после спавна
  "MoneyMode": 0,

  // Delete dropped weapons every N seconds (0 - off)
  // Удалять выпавшее оружие каждые N секунд (0 - выкл)
  "DeleteDroppedInterval": 3,

  // mp_weapons_allow_typecount: сколько одинаковых оружий можно купить за раунд.
  // На разминке WarmupTypeCount (-1 — без ограничений), после разминки MatchTypeCount.
  // ControlTypeCount: false — плагин не трогает эту настройку.
  "ControlTypeCount": true,
  "WarmupTypeCount": -1,
  "MatchTypeCount": 2,

  // Ножевой раунд после разминки: "vote" — голосование, "always" — всегда, "off" — выкл.
  "KnifeRoundMode": "vote",

  // За сколько секунд до конца разминки показать голосование «Ножевой раунд?».
  "KnifeVoteBeforeEnd": 30,

  // Ничья или никто не проголосовал: true — ножевой раунд будет, false — не будет.
  "KnifeVoteTieResult": false,

  // Кто зашёл за T/CT во время голосования — тоже получает его, пока до конца разминки не меньше N секунд.
  "VoteJoinUntil": 5,

  // Броня на ножевом раунде: 0 — без брони, 1 — бронежилет, 2 — бронежилет + шлем.
  "KnifeArmor": 0,

  // Здоровье на ножевом раунде.
  "KnifeHealth": 100,

  // Через сколько секунд после начала ножевого раунда ещё раз полностью сбросить игроков (0 — выкл).
  // Один раз за раунд: забрать всё, кроме ножа (оружие, гранаты, медшприц, щипцы), выставить HP и броню.
  // Зачем: VIP и другие плагины выдают оружие, медшприц, HP, броню и шлем через пару секунд после спавна,
  // а кто-то успевает поднять или купить оружие в самом начале раунда. Этот сброс всё это убирает.
  "KnifeResetDelay": 5,

  // Квары сервера на время ножевого раунда ("имя значение"). По умолчанию — бхоп со скоростью для всех.
  // Перед ними плагин запоминает текущие значения этих кваров.
  "KnifeCvars": ["sv_enablebunnyhopping 1", "sv_autobunnyhopping 1", "sv_airaccelerate 2000", "sv_maxvelocity 7000", "sv_staminamax 0", "sv_staminarecoveryrate 0", "sv_accelerate_use_weapon_speed 0"],

  // Квары после ножевого раунда ("имя значение"). Пустой список [] — вернуть значения,
  // которые были до ножевого раунда (запомненные).
  "AfterKnifeCvars": ["sv_enablebunnyhopping 0", "sv_autobunnyhopping 0", "sv_airaccelerate 12", "sv_maxvelocity 3500", "sv_staminamax 80", "sv_staminarecoveryrate 60", "sv_accelerate_use_weapon_speed 1"],

  // Через сколько секунд после ножевого раунда начинается выбор стороны (0 — сразу).
  "KnifeRoundEndDelay": 1,

  // Сколько секунд победители выбирают сторону (разминка на паузе).
  "SideVoteTime": 15,

  // Как голосовать: 1 — мышка (+ запасной чат), 2 — только мышка, 3 — только чат (плашка видна, курсора нет).
  "MenuType": 1,

  // Слова в чате, которые считаются голосом. Регистр и "!" / "/" в начале не важны:
  // "1", "!1", "/1" — одно и то же. Сообщение должно состоять только из этого слова.
  // Yes / No — голосование за ножевой раунд, T / CT — выбор стороны.
  "ChatType": {
    "Yes": ["1", "yes", "да", "+"],
    "No": ["2", "no", "нет", "-"],
    "T": ["1", "t", "т"],
    "CT": ["2", "ct", "кт"]
  },

  // Скомпилированная разметка в клиентском аддоне (обратите внимание на _c).
  "LayoutPath": "panorama/layout/custom_game/faceit_simple_cs2.vxml_c",

  // Подробный лог.
  "Debug": false,

  "ConfigVersion": 5
}
